rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isEditor() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    match /product-images/{filename} {
      allow get: if true; // Product pictures are public.
      allow list: if false;
      allow create, update: if isEditor()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isEditor();
    }
  }
}
